<div class="rebelExperimentsPlugin">
    <div class="card">
        <div class="card-content">
            {% if experiment is empty %}
            <div class="alert">{{ 'RebelExperiments_ExperimentNotFound'|translate }}</div>
            {% else %}
            <h2>{{ experiment.name }}</h2>
            <p>
                <span class="rebelExperimentsStatus rebelExperimentsStatus-{{ experiment.status }}">{{ ('RebelExperiments_Status_' ~ experiment.status)|translate }}</span>
                {{ experiment.from_date }} &ndash; {{ experiment.to_date }}
            </p>
            {% if audience %}
            <p><strong>{{ 'RebelExperiments_AudienceTitle'|translate }}:</strong> {{ audience }}</p>
            {% endif %}
            {% if canWrite and experiment.hypothesis is not empty %}
            <p><strong>{{ 'RebelExperiments_FormHypothesis'|translate }}:</strong> {{ experiment.hypothesis }}</p>
            {% endif %}
            {% if canWrite and experiment.description is not empty %}
            <p><strong>{{ 'General_Description'|translate }}:</strong> {{ experiment.description }}</p>
            {% endif %}

            {% if canRollOut %}
            <form method="post" action="{{ rollOutUrl }}" class="rebelExperimentsRollOut">
                <input type="hidden" name="nonce" value="{{ nonce }}">
                <input type="hidden" name="id" value="{{ experiment.id }}">
                <label for="rollout_variant"><strong>{{ 'RebelExperiments_RollOutLabel'|translate }}:</strong></label>
                <select name="variant" id="rollout_variant" class="browser-default">
                    {% for variant in result.variants|slice(1) %}
                    <option value="{{ variant.variant }}">{{ variant.name }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="rebelExperimentsSecondary">{{ 'RebelExperiments_RollOutButton'|translate }}</button>
                <span class="form-hint">{{ 'RebelExperiments_RollOutHint'|translate }}</span>
            </form>
            {% endif %}
            {% if previewLinks is not empty %}
            <p>
                <strong>{{ 'RebelExperiments_ResultPreview'|translate }}:</strong>
                {% for name, link in previewLinks %}
                <a href="{{ link }}" target="_blank" rel="noreferrer noopener">{{ name }}</a>{% if not loop.last %} &middot; {% endif %}
                {% endfor %}
                <span class="form-hint">{{ 'RebelExperiments_ResultPreviewHelp'|translate }}</span>
            </p>
            {% endif %}

            {% if experiment.kind in ['fake_door', 'watch'] %}
            <h3 class="form-section-title">{{ ('RebelExperiments_Kind_' ~ experiment.kind)|translate }}: {{ experiment.kind == 'watch' ? experiment.door.selector : experiment.door.label }}</h3>
            <table class="rebelExperimentsTable">
                <thead>
                    <tr>
                        <th>{{ 'RebelExperiments_DoorResultVisits'|translate }}</th>
                        <th>{{ 'RebelExperiments_DoorResultClicks'|translate }}</th>
                        <th>{{ 'RebelExperiments_DoorResultRate'|translate }}</th>
                        <th>{{ 'RebelExperiments_DoorResultRange'|translate }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ result.nb_visits|number }}</td>
                        <td>{{ result.nb_clicks|number }}</td>
                        <td>{{ (result.click_rate * 100)|number(1) }}%</td>
                        <td>{{ (result.click_rate_range[0] * 100)|number(1) }}% &ndash; {{ (result.click_rate_range[1] * 100)|number(1) }}%</td>
                    </tr>
                </tbody>
            </table>
            <p class="section-help">{{ 'RebelExperiments_DoorResultHelp'|translate }}</p>
            {% else %}
            {% if result.is_split_even is same as(false) %}
            <div class="alert rebelExperimentsSplitWarning">{{ 'RebelExperiments_ResultSplitUneven'|translate }}</div>
            {% endif %}

            <h3 class="form-section-title">{{ 'RebelExperiments_ResultVisits'|translate }}</h3>
            <table class="rebelExperimentsTable">
                <thead>
                    <tr>
                        <th>{{ 'RebelExperiments_Variant'|translate }}</th>
                        <th>{{ 'RebelExperiments_ResultVisitors'|translate }}</th>
                        <th>{{ 'RebelExperiments_NbVisits'|translate }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for variant in result.variants %}
                    <tr>
                        <td>{{ variant.name }}</td>
                        <td>{{ variant.nb_visitors|number }}</td>
                        <td>{{ variant.nb_visits|number }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if evolution %}
            {% include '@RebelExperiments/_evolution.twig' %}
            {% endif %}

            {% for measure in result.measures %}
            {% set judged = measure.role != 'other' or experiment.primary_measure is null %}
            <h3 class="form-section-title">
                {% if measure.role == 'primary' %}{{ 'RebelExperiments_ResultPrimaryMeasure'|translate(measure.name) }}{% elseif measure.role == 'guardrail' %}{{ 'RebelExperiments_ResultGuardrail'|translate(measure.name) }}{% else %}{{ measure.name }}{% endif %}
            </h3>
            <table class="rebelExperimentsTable rebelExperimentsMeasureTable-{{ measure.role }}">
                <thead>
                    <tr>
                        <th>{{ 'RebelExperiments_Variant'|translate }}</th>
                        <th>{{ 'RebelExperiments_ResultVisitsWithOutcome'|translate }}</th>
                        <th>{{ (measure.unit == 'share' ? 'RebelExperiments_ResultShare' : 'RebelExperiments_ResultAmount')|translate }}{% if measure.is_lower_better %} ({{ 'RebelExperiments_ResultLowerIsBetter'|translate }}){% endif %}</th>
                        <th>{{ 'RebelExperiments_ResultUplift'|translate }}</th>
                        <th>{{ 'RebelExperiments_ResultChance'|translate }}</th>
                        {% if judged %}<th>{{ 'RebelExperiments_ResultVerdict'|translate }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for variant in measure.variants %}
                    <tr>
                        <td>{{ variant.name }}</td>
                        <td>{{ variant.nb_visits_with_outcome|number }}</td>
                        <td>{{ variant.value_formatted }}</td>
                        <td>{% if variant.uplift is not null %}{{ variant.uplift > 0 ? '+' : '' }}{{ (variant.uplift * 100)|number(1) }}%{% endif %}</td>
                        <td>{% if variant.chance_to_be_better is not null %}{{ (variant.chance_to_be_better * 100)|number(1) }}%{% endif %}</td>
                        {% if judged %}<td>{% if variant.verdict %}<span class="rebelExperimentsVerdict rebelExperimentsVerdict-{{ variant.verdict }}">{{ ('RebelExperiments_Verdict_' ~ variant.verdict)|translate }}</span>{% endif %}</td>{% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div class="alert">{{ 'RebelExperiments_ResultNoConversions'|translate }}</div>
            {% endfor %}

            <p class="section-help">{{ (experiment.primary_measure is null ? 'RebelExperiments_ResultHelpNoPrimaryGoal' : 'RebelExperiments_ResultHelp')|translate(experiment.confidence) }}</p>
            {% endif %}

            <h3 class="form-section-title">{{ 'RebelExperiments_DecisionTitle'|translate }}</h3>
            {% if experiment.decision %}
            <p class="rebelExperimentsDecision">
                <strong>{{ ('RebelExperiments_Decision_' ~ experiment.decision)|translate }}</strong>
                <span class="form-hint">{{ 'RebelExperiments_DecisionBy'|translate(experiment.decided_by, experiment.decided_at) }}</span>
            </p>
            {% if experiment.decision_note %}<p class="rebelExperimentsDecisionNote">{{ experiment.decision_note }}</p>{% endif %}
            {% elseif not canWrite %}
            <p class="section-help">{{ 'RebelExperiments_DecisionNone'|translate }}</p>
            {% endif %}
            {% if canWrite %}
            <details class="rebelExperimentsMore"{% if not experiment.decision %} open{% endif %}>
                <summary>{{ (experiment.decision ? 'RebelExperiments_DecisionChange' : 'RebelExperiments_DecisionRecord')|translate }}</summary>
                <form method="post" action="{{ decideUrl }}" class="rebelExperimentsDecide">
                    <input type="hidden" name="nonce" value="{{ nonce }}">
                    <input type="hidden" name="id" value="{{ experiment.id }}">
                    <div class="rebelExperimentsField rebelExperimentsNarrow">
                        <label for="decision">{{ 'RebelExperiments_DecisionWhat'|translate }}</label>
                        <select name="decision" id="decision" class="browser-default">
                            {% for decision in decisions %}
                            <option value="{{ decision }}"{% if decision == experiment.decision %} selected{% endif %}>{{ (decision == '' ? 'RebelExperiments_DecisionNotYet' : 'RebelExperiments_Decision_' ~ decision)|translate }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="rebelExperimentsField">
                        <label for="decision_note">{{ 'RebelExperiments_DecisionWhy'|translate }}</label>
                        <textarea name="note" id="decision_note" class="code-textarea rebelExperimentsNote" maxlength="2000">{{ experiment.decision_note }}</textarea>
                        <span class="form-hint">{{ 'RebelExperiments_DecisionWhyHint'|translate }}</span>
                    </div>
                    <button type="submit" class="rebelExperimentsSecondary">{{ 'RebelExperiments_DecisionSave'|translate }}</button>
                </form>
            </details>
            {% endif %}
            {% endif %}
        </div>
    </div>
</div>
