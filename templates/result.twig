<div class="rebelABTestingPlugin">
    <div class="card">
        <div class="card-content">
            {% if experiment is empty %}
            <div class="alert">{{ 'RebelABTesting_ExperimentNotFound'|translate }}</div>
            {% else %}
            <h2>{{ experiment.name }}</h2>
            <p>
                <span class="rebelABTestingStatus rebelABTestingStatus-{{ experiment.status }}">{{ ('RebelABTesting_Status_' ~ experiment.status)|translate }}</span>
                {{ experiment.from_date }} &ndash; {{ experiment.to_date }}
            </p>
            {% if audience %}
            <p><strong>{{ 'RebelABTesting_AudienceTitle'|translate }}:</strong> {{ audience }}</p>
            {% endif %}
            {% if canWrite and experiment.hypothesis is not empty %}
            <p><strong>{{ 'RebelABTesting_FormHypothesis'|translate }}:</strong> {{ experiment.hypothesis }}</p>
            {% endif %}
            {% if canWrite and experiment.description is not empty %}
            <p><strong>{{ 'General_Description'|translate }}:</strong> {{ experiment.description }}</p>
            {% endif %}

            {% if previewLinks is not empty %}
            <p>
                <strong>{{ 'RebelABTesting_ResultPreview'|translate }}:</strong>
                {% for name, link in previewLinks %}
                <a href="{{ link }}" target="_blank" rel="noreferrer noopener">{{ name }}</a>{% if not loop.last %} &middot; {% endif %}
                {% endfor %}
                <span class="form-hint">{{ 'RebelABTesting_ResultPreviewHelp'|translate }}</span>
            </p>
            {% endif %}

            {% if experiment.kind != 'ab' %}
            <h3 class="form-section-title">{{ ('RebelABTesting_Kind_' ~ experiment.kind)|translate }}: {{ experiment.kind == 'watch' ? experiment.door.selector : experiment.door.label }}</h3>
            <table class="rebelABTestingTable">
                <thead>
                    <tr>
                        <th>{{ 'RebelABTesting_DoorResultVisits'|translate }}</th>
                        <th>{{ 'RebelABTesting_DoorResultClicks'|translate }}</th>
                        <th>{{ 'RebelABTesting_DoorResultRate'|translate }}</th>
                        <th>{{ 'RebelABTesting_DoorResultRange'|translate }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ result.nb_visits|number }}</td>
                        <td>{{ result.nb_clicks|number }}</td>
                        <td>{{ (result.click_rate * 100)|number(1) }}%</td>
                        <td>{{ (result.click_rate_range[0] * 100)|number(1) }}% &ndash; {{ (result.click_rate_range[1] * 100)|number(1) }}%</td>
                    </tr>
                </tbody>
            </table>
            <p class="section-help">{{ 'RebelABTesting_DoorResultHelp'|translate }}</p>
            {% else %}
            {% if result.is_split_even is same as(false) %}
            <div class="alert rebelABTestingSplitWarning">{{ 'RebelABTesting_ResultSplitUneven'|translate }}</div>
            {% endif %}

            <h3 class="form-section-title">{{ 'RebelABTesting_ResultVisits'|translate }}</h3>
            <table class="rebelABTestingTable">
                <thead>
                    <tr>
                        <th>{{ 'RebelABTesting_Variant'|translate }}</th>
                        <th>{{ 'RebelABTesting_ResultVisitors'|translate }}</th>
                        <th>{{ 'RebelABTesting_NbVisits'|translate }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for variant in result.variants %}
                    <tr>
                        <td>{{ variant.name }}</td>
                        <td>{{ variant.nb_visitors|number }}</td>
                        <td>{{ variant.nb_visits|number }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if evolution %}
            {% include '@RebelABTesting/_evolution.twig' %}
            {% endif %}

            {% for measure in result.measures %}
            {% set judged = measure.role != 'other' or experiment.primary_measure is null %}
            <h3 class="form-section-title">
                {% if measure.role == 'primary' %}{{ 'RebelABTesting_ResultPrimaryMeasure'|translate(measure.name) }}{% elseif measure.role == 'guardrail' %}{{ 'RebelABTesting_ResultGuardrail'|translate(measure.name) }}{% else %}{{ measure.name }}{% endif %}
            </h3>
            <table class="rebelABTestingTable rebelABTestingMeasureTable-{{ measure.role }}">
                <thead>
                    <tr>
                        <th>{{ 'RebelABTesting_Variant'|translate }}</th>
                        <th>{{ 'RebelABTesting_ResultVisitsWithOutcome'|translate }}</th>
                        <th>{{ (measure.unit == 'share' ? 'RebelABTesting_ResultShare' : 'RebelABTesting_ResultAmount')|translate }}{% if measure.is_lower_better %} ({{ 'RebelABTesting_ResultLowerIsBetter'|translate }}){% endif %}</th>
                        <th>{{ 'RebelABTesting_ResultUplift'|translate }}</th>
                        <th>{{ 'RebelABTesting_ResultChance'|translate }}</th>
                        {% if judged %}<th>{{ 'RebelABTesting_ResultVerdict'|translate }}</th>{% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for variant in measure.variants %}
                    <tr>
                        <td>{{ variant.name }}</td>
                        <td>{{ variant.nb_visits_with_outcome|number }}</td>
                        <td>{{ variant.value_formatted }}</td>
                        <td>{% if variant.uplift is not null %}{{ variant.uplift > 0 ? '+' : '' }}{{ (variant.uplift * 100)|number(1) }}%{% endif %}</td>
                        <td>{% if variant.chance_to_be_better is not null %}{{ (variant.chance_to_be_better * 100)|number(1) }}%{% endif %}</td>
                        {% if judged %}<td>{% if variant.verdict %}<span class="rebelABTestingVerdict rebelABTestingVerdict-{{ variant.verdict }}">{{ ('RebelABTesting_Verdict_' ~ variant.verdict)|translate }}</span>{% endif %}</td>{% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div class="alert">{{ 'RebelABTesting_ResultNoConversions'|translate }}</div>
            {% endfor %}

            <p class="section-help">{{ (experiment.primary_measure is null ? 'RebelABTesting_ResultHelpNoPrimaryGoal' : 'RebelABTesting_ResultHelp')|translate(experiment.confidence) }}</p>
            {% endif %}
            {% endif %}
        </div>
    </div>
</div>
