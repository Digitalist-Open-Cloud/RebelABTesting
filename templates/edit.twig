<div class="rebelExperimentsPlugin">
    <div class="card">
        <div class="card-content">
            <h2>{{ 'RebelExperiments_EditExperiment'|translate }}</h2>
            <a href="{{ backUrl }}" class="back-link rebelExperimentsBack">&laquo; {{ 'RebelExperiments_FormBack'|translate }}</a>
            {% if experiment is empty %}
            <div class="alert">{{ 'RebelExperiments_ExperimentNotFound'|translate }}</div>
            {% else %}
            {% include '@RebelExperiments/_form.twig' with {submitLabel: 'RebelExperiments_FormSave'|translate} %}
            {% endif %}
        </div>
    </div>
</div>
