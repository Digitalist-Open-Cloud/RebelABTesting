<div class="rebelABTestingPlugin">
    <div class="card">
        <div class="card-content">
            <h2>{{ 'RebelABTesting_CreateNewExperiment'|translate }}</h2>
            <form method="post" action="{{ actionUrl }}">
                <input type="hidden" name="nonce" value="{{ nonce }}">

                <h3 class="form-section-title">{{ 'RebelABTesting_FormBasicInfo'|translate }}</h3>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="name">{{ 'RebelABTesting_ExperimentName'|translate }}</label>
                        <input type="text" name="name" id="name" value="" required>
                        <span class="form-hint">{{ 'RebelABTesting_FormNameHintNew'|translate }}</span>
                    </div>
                    <div class="col s12 m6 form-field">
                        <label for="hypothesis">{{ 'RebelABTesting_FormHypothesis'|translate }}</label>
                        <input type="text" name="hypothesis" id="hypothesis" value="">
                        <span class="form-hint">{{ 'RebelABTesting_FormHypothesisHint'|translate }}</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="description">{{ 'General_Description'|translate }}</label>
                        <input type="text" name="description" id="description" value="">
                    </div>
                </div>

                <h3 class="form-section-title">{{ 'RebelABTesting_FormSchedule'|translate }}</h3>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="from_date">{{ 'RebelABTesting_FormFromDate'|translate }}</label>
                        <input type="date" name="from_date" id="from_date" value="{{ fromDate }}" required>
                        <span class="form-hint">{{ 'RebelABTesting_FormFromDateHint'|translate }}</span>
                    </div>
                    <div class="col s12 m6 form-field">
                        <label for="to_date">{{ 'RebelABTesting_FormToDate'|translate }}</label>
                        <input type="date" name="to_date" id="to_date" value="{{ toDate }}" required>
                        <span class="form-hint">{{ 'RebelABTesting_FormToDateHint'|translate }}</span>
                    </div>
                </div>

                <h3 class="form-section-title">{{ 'RebelABTesting_FormVariantCode'|translate }}</h3>
                <p class="section-help">{{ 'RebelABTesting_FormVariantCodeHelp'|translate }}</p>
                <div class="row">
                    <div class="col s12 code-field">
                        <label for="css_insert">{{ 'RebelABTesting_FormCss'|translate }}</label>
                        <textarea name="css_insert" id="css_insert" class="code-textarea"></textarea>
                        <span class="form-hint">{{ 'RebelABTesting_FormExample'|translate }} <code>.btn { background-color: #ff5722; }</code></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12 code-field">
                        <label for="js_insert">{{ 'RebelABTesting_FormJavaScript'|translate }}</label>
                        <textarea name="js_insert" id="js_insert" class="code-textarea"></textarea>
                        <span class="form-hint">{{ 'RebelABTesting_FormExample'|translate }} <code>document.querySelector('h1').textContent = 'New headline';</code></span>
                    </div>
                </div>

                <div class="form-actions">
                    <input type="submit" value="{{ 'RebelABTesting_FormAdd'|translate }}" class="btn">
                </div>
            </form>
        </div>
    </div>
</div>
