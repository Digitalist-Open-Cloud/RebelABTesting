<div class="rebelABTestingPlugin">
    <div class="card">
        <div class="card-content">
            <h2>{{ 'RebelABTesting_CreateNewExperiment'|translate }}</h2>
            <form method="post" action="{{ actionUrl }}">
                <input type="hidden" name="nonce" value="{{ nonce }}">

                <h3 class="form-section-title">Basic info</h3>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="name">Experiment Name</label>
                        <input type="text" name="name" id="name" value="" required>
                        <span class="form-hint">Letters, digits, - and _ only. Use a new name for every experiment.</span>
                    </div>
                    <div class="col s12 m6 form-field">
                        <label for="hypothesis">Hypothesis</label>
                        <input type="text" name="hypothesis" id="hypothesis" value="">
                        <span class="form-hint">What you expect and why, for example &ldquo;A green button gets more clicks.&rdquo;</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="description">Description</label>
                        <input type="text" name="description" id="description" value="">
                    </div>
                </div>

                <h3 class="form-section-title">Schedule</h3>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="from_date">From Date</label>
                        <input type="date" name="from_date" id="from_date" value="{{ fromDate }}" required>
                        <span class="form-hint">Starts at 00:00 UTC.</span>
                    </div>
                    <div class="col s12 m6 form-field">
                        <label for="to_date">To Date</label>
                        <input type="date" name="to_date" id="to_date" value="{{ toDate }}" required>
                        <span class="form-hint">Ends at 23:59 UTC.</span>
                    </div>
                </div>

                <h3 class="form-section-title">Variant code</h3>
                <p class="section-help">Fill in CSS, JavaScript or both. Use CSS for how the page looks and JavaScript for what it does or says.</p>
                <div class="row">
                    <div class="col s12 code-field">
                        <label for="css_insert">CSS for the variant</label>
                        <textarea name="css_insert" id="css_insert" class="code-textarea"></textarea>
                        <span class="form-hint">For example <code>.btn { background-color: #ff5722; }</code></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12 code-field">
                        <label for="js_insert">JavaScript for the variant</label>
                        <textarea name="js_insert" id="js_insert" class="code-textarea"></textarea>
                        <span class="form-hint">For example <code>document.querySelector('h1').textContent = 'New headline';</code></span>
                    </div>
                </div>

                <div class="form-actions">
                    <input type="submit" value="Add Experiment" class="btn">
                </div>
            </form>
        </div>
    </div>
</div>
