{% macro measure(field, label, hint, selected, measures) %}
    {% set choice = selected is null ? '' : (selected.type == 'goal' ? 'goal:' ~ selected.idgoal : selected.type) %}
    <div class="rebelABTestingMeasure">
        <div class="rebelABTestingField">
            <label for="{{ field }}">{{ label }}</label>
            <select name="{{ field }}" id="{{ field }}" class="browser-default">
                {% for value, name in measures %}
                <option value="{{ value }}"{% if (value ~ '') == choice %} selected{% endif %}>{{ name }}</option>
                {% endfor %}
            </select>
            {% if hint %}<span class="form-hint">{{ hint }}</span>{% endif %}
        </div>
        <div class="rebelABTestingColumns rebelABTestingMeasureEvent">
            <div class="rebelABTestingField">
                <label for="{{ field }}_category">{{ 'RebelABTesting_FormEventCategory'|translate }}</label>
                <input type="text" name="{{ field }}_category" id="{{ field }}_category" value="{{ selected.category ?? '' }}" maxlength="200">
            </div>
            <div class="rebelABTestingField">
                <label for="{{ field }}_action">{{ 'RebelABTesting_FormEventAction'|translate }}</label>
                <input type="text" name="{{ field }}_action" id="{{ field }}_action" value="{{ selected.action ?? '' }}" maxlength="200">
            </div>
        </div>
    </div>
{% endmacro %}

<form method="post" action="{{ actionUrl }}" class="rebelABTestingForm">
    <input type="hidden" name="nonce" value="{{ nonce }}">
    {% if experiment.id is defined %}<input type="hidden" name="id" value="{{ experiment.id }}">{% endif %}

    <nav class="rebelABTestingSteps" aria-label="{{ 'RebelABTesting_StepsLabel'|translate }}">
        <button type="button" class="rebelABTestingStep" data-panel="basics"><span class="rebelABTestingStepNumber"></span>{{ 'RebelABTesting_StepBasics'|translate }}</button>
        <button type="button" class="rebelABTestingStep" data-panel="changes"><span class="rebelABTestingStepNumber"></span><span data-kind="ab">{{ 'RebelABTesting_StepChanges'|translate }}</span><span data-kind="fake_door">{{ 'RebelABTesting_Kind_fake_door'|translate }}</span><span data-kind="watch">{{ 'RebelABTesting_StepWatch'|translate }}</span></button>
        <button type="button" class="rebelABTestingStep" data-panel="audience"><span class="rebelABTestingStepNumber"></span>{{ 'RebelABTesting_StepAudience'|translate }}</button>
        <button type="button" class="rebelABTestingStep" data-panel="measures" data-kind="ab"><span class="rebelABTestingStepNumber"></span>{{ 'RebelABTesting_StepMeasures'|translate }}</button>
        <button type="button" class="rebelABTestingStep" data-panel="schedule"><span class="rebelABTestingStepNumber"></span>{{ 'RebelABTesting_StepSchedule'|translate }}</button>
    </nav>

    <section class="rebelABTestingPanel" data-panel="basics">
        <h3 class="form-section-title">{{ 'RebelABTesting_FormKind'|translate }}</h3>
        <div class="rebelABTestingKinds">
            {% for kind in kinds %}
            <label class="rebelABTestingKindChoice">
                <input type="radio" name="kind" value="{{ kind }}" class="rebelABTestingKind"{% if kind == experiment.kind %} checked{% endif %}>
                <span class="rebelABTestingKindName">{{ ('RebelABTesting_Kind_' ~ kind)|translate }}</span>
                <span class="rebelABTestingKindHelp">{{ ('RebelABTesting_KindHelp_' ~ kind)|translate }}</span>
            </label>
            {% endfor %}
        </div>

        <h3 class="form-section-title">{{ 'RebelABTesting_FormBasicInfo'|translate }}</h3>
        <div class="rebelABTestingField">
            <label for="name">{{ 'RebelABTesting_ExperimentName'|translate }}</label>
            <input type="text" name="name" id="name" value="{{ experiment.name }}" maxlength="255" required>
        </div>
        <div class="rebelABTestingField">
            <label for="hypothesis">{{ 'RebelABTesting_FormHypothesis'|translate }} <span class="rebelABTestingOptional">{{ 'RebelABTesting_FormOptional'|translate }}</span></label>
            <input type="text" name="hypothesis" id="hypothesis" value="{{ experiment.hypothesis }}">
            <span class="form-hint">{{ 'RebelABTesting_FormHypothesisHint'|translate }}</span>
        </div>
        <div class="rebelABTestingField">
            <label for="description">{{ 'General_Description'|translate }} <span class="rebelABTestingOptional">{{ 'RebelABTesting_FormOptional'|translate }}</span></label>
            <input type="text" name="description" id="description" value="{{ experiment.description }}">
        </div>
    </section>

    <section class="rebelABTestingPanel" data-panel="changes">
        <div data-kind="fake_door">
            {% set door = experiment.kind == 'fake_door' ? experiment.door : {selector: '', position: 'after', element: 'button', label: '', css_class: '', message: ''} %}
            <h3 class="form-section-title">{{ 'RebelABTesting_DoorTitle'|translate }}</h3>
            <p class="section-help">{{ 'RebelABTesting_DoorHelp'|translate }}</p>
            <div class="rebelABTestingColumns">
                <div class="rebelABTestingField">
                    <label for="door_label">{{ 'RebelABTesting_DoorLabel'|translate }}</label>
                    <input type="text" name="door[label]" id="door_label" value="{{ door.label }}" maxlength="200">
                </div>
                <div class="rebelABTestingField">
                    <label for="door_element">{{ 'RebelABTesting_DoorElement'|translate }}</label>
                    <select name="door[element]" id="door_element" class="browser-default">
                        {% for element in doorElements %}
                        <option value="{{ element }}"{% if element == door.element %} selected{% endif %}>{{ ('RebelABTesting_DoorElement_' ~ element)|translate }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="rebelABTestingField">
                <label for="door_message">{{ 'RebelABTesting_DoorMessage'|translate }}</label>
                <input type="text" name="door[message]" id="door_message" value="{{ door.message }}" maxlength="500">
                <span class="form-hint">{{ 'RebelABTesting_DoorMessageHint'|translate }}</span>
            </div>
            <div class="rebelABTestingColumns">
                <div class="rebelABTestingField">
                    <label for="door_selector">{{ 'RebelABTesting_DoorSelector'|translate }}</label>
                    <input type="text" name="door[selector]" id="door_selector" value="{{ door.selector }}" maxlength="500" placeholder="#main-menu">
                    <span class="form-hint">{{ 'RebelABTesting_DoorSelectorHint'|translate }}</span>
                </div>
                <div class="rebelABTestingField">
                    <label for="door_position">{{ 'RebelABTesting_DoorPosition'|translate }}</label>
                    <select name="door[position]" id="door_position" class="browser-default">
                        {% for position in doorPositions %}
                        <option value="{{ position }}"{% if position == door.position %} selected{% endif %}>{{ ('RebelABTesting_DoorPosition_' ~ position)|translate }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <details class="rebelABTestingMore"{% if door.css_class %} open{% endif %}>
                <summary>{{ 'RebelABTesting_FormMore'|translate }}</summary>
                <div class="rebelABTestingField">
                    <label for="door_css_class">{{ 'RebelABTesting_DoorCssClass'|translate }}</label>
                    <input type="text" name="door[css_class]" id="door_css_class" value="{{ door.css_class }}" maxlength="200">
                    <span class="form-hint">{{ 'RebelABTesting_DoorCssClassHint'|translate }}</span>
                </div>
            </details>
        </div>

        <div data-kind="watch">
            <h3 class="form-section-title">{{ 'RebelABTesting_WatchTitle'|translate }}</h3>
            <p class="section-help">{{ 'RebelABTesting_WatchHelp'|translate }}</p>
            <div class="rebelABTestingField">
                <label for="watch_selector">{{ 'RebelABTesting_WatchSelector'|translate }}</label>
                <input type="text" name="watch[selector]" id="watch_selector" value="{{ experiment.kind == 'watch' ? experiment.door.selector : '' }}" maxlength="500" placeholder=".newsletter-signup">
                <span class="form-hint">{{ 'RebelABTesting_WatchSelectorHint'|translate }}</span>
            </div>
        </div>

        <div data-kind="ab">
            <p class="section-help">{{ 'RebelABTesting_FormVariantsHelp'|translate }}</p>
            <div class="rebelABTestingVariants" data-max="{{ maxVariants }}">
                {% for variant in experiment.variants %}
                <fieldset class="rebelABTestingVariant">
                    <div class="rebelABTestingVariantHead">
                        <span class="rebelABTestingVariantTitle">{{ 'RebelABTesting_Variant'|translate }} <span class="rebelABTestingVariantNumber">{{ loop.index }}</span></span>
                        <input type="text" name="variants[{{ loop.index0 }}][name]" value="{{ variant.name }}" maxlength="100" placeholder="{{ 'RebelABTesting_VariantNamePlaceholder'|translate }}" aria-label="{{ 'General_Name'|translate }}">
                        <button type="button" class="rebelABTestingLink rebelABTestingRemoveVariant">{{ 'RebelABTesting_FormRemoveVariant'|translate }}</button>
                    </div>

                    <div class="rebelABTestingField rebelABTestingTemplateField">
                        <label>{{ 'RebelABTesting_TemplateStart'|translate }}</label>
                        <select class="browser-default rebelABTestingTemplate">
                            <option value="">{{ 'RebelABTesting_TemplateNone'|translate }}</option>
                            {% for key, template in templates %}
                            <option value="{{ key }}" data-changes="{{ template.changes|json_encode }}">{{ template.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="rebelABTestingChangeHead">
                        <span>{{ 'RebelABTesting_ChangeSelector'|translate }}</span>
                        <span>{{ 'RebelABTesting_ChangeAction'|translate }}</span>
                        <span>{{ 'RebelABTesting_ChangeValue'|translate }}</span>
                    </div>
                    <div class="rebelABTestingChanges">
                        {% for change in (variant.changes is empty ? [{selector: '', action: 'text', value: ''}] : variant.changes) %}
                        <div class="rebelABTestingChange">
                            <input type="text" name="variants[{{ loop.parent.loop.index0 }}][changes][{{ loop.index0 }}][selector]" value="{{ change.selector }}" maxlength="500" placeholder="h1" aria-label="{{ 'RebelABTesting_ChangeSelector'|translate }}">
                            <select name="variants[{{ loop.parent.loop.index0 }}][changes][{{ loop.index0 }}][action]" class="browser-default" aria-label="{{ 'RebelABTesting_ChangeAction'|translate }}">
                                {% for action in actions %}
                                <option value="{{ action }}" data-placeholder="{{ ('RebelABTesting_ActionValue_' ~ action)|translate }}"{% if action == change.action %} selected{% endif %}>{{ ('RebelABTesting_Action_' ~ action)|translate }}</option>
                                {% endfor %}
                            </select>
                            <input type="text" name="variants[{{ loop.parent.loop.index0 }}][changes][{{ loop.index0 }}][value]" value="{{ change.value }}" maxlength="2000" aria-label="{{ 'RebelABTesting_ChangeValue'|translate }}">
                            <button type="button" class="rebelABTestingIconButton rebelABTestingRemoveChange" title="{{ 'RebelABTesting_ChangeRemove'|translate }}" aria-label="{{ 'RebelABTesting_ChangeRemove'|translate }}">&times;</button>
                        </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="rebelABTestingLink rebelABTestingAddChange">+ {{ 'RebelABTesting_ChangeAdd'|translate }}</button>
                    <p class="form-hint">{{ 'RebelABTesting_ChangesHelp'|translate }}</p>

                    <details class="rebelABTestingMore"{% if variant.redirect %} open{% endif %}>
                        <summary>{{ 'RebelABTesting_RedirectTitle'|translate }}</summary>
                        <div class="rebelABTestingField">
                            <label>{{ 'RebelABTesting_RedirectAddress'|translate }}</label>
                            <input type="text" name="variants[{{ loop.index0 }}][redirect]" value="{{ variant.redirect }}" maxlength="2000" placeholder="/pricing-b">
                            <span class="form-hint">{{ 'RebelABTesting_RedirectHint'|translate }}</span>
                        </div>
                    </details>

                    {% if canUseCode %}
                    <details class="rebelABTestingMore"{% if variant.css or variant.js %} open{% endif %}>
                        <summary>{{ 'RebelABTesting_CodeTitle'|translate }}</summary>
                        <div class="rebelABTestingField">
                            <label>CSS</label>
                            <textarea name="variants[{{ loop.index0 }}][css]" class="code-textarea" placeholder=".btn { background-color: #ff5722; }">{{ variant.css }}</textarea>
                        </div>
                        <div class="rebelABTestingField">
                            <label>JavaScript</label>
                            <textarea name="variants[{{ loop.index0 }}][js]" class="code-textarea" placeholder="document.querySelector('h1').textContent = 'New headline';">{{ variant.js }}</textarea>
                        </div>
                    </details>
                    {% endif %}
                </fieldset>
                {% endfor %}
            </div>
            <button type="button" class="rebelABTestingLink rebelABTestingAddVariant">+ {{ 'RebelABTesting_FormAddVariant'|translate }}</button>
        </div>
    </section>

    <section class="rebelABTestingPanel" data-panel="audience">
        <h3 class="form-section-title">{{ 'RebelABTesting_FormPages'|translate }}</h3>
        <div class="rebelABTestingColumns">
            <div class="rebelABTestingField">
                <label for="target_match">{{ 'RebelABTesting_FormTargetMatch'|translate }}</label>
                <select name="target_match" id="target_match" class="browser-default">
                    {% for match in matches %}
                    <option value="{{ match }}"{% if match == experiment.target_match %} selected{% endif %}>{{ ('RebelABTesting_Match_' ~ match)|translate }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="rebelABTestingField rebelABTestingTargetValue">
                <label for="target_value">{{ 'RebelABTesting_FormTargetValue'|translate }}</label>
                <input type="text" name="target_value" id="target_value" value="{{ experiment.target_value }}" maxlength="1000" placeholder="/pricing">
                <span class="form-hint">{{ 'RebelABTesting_FormTargetValueHint'|translate }}</span>
            </div>
        </div>

        <h3 class="form-section-title">{{ 'RebelABTesting_FormVisitors'|translate }}</h3>
        <div class="rebelABTestingField rebelABTestingNarrow">
            <label for="traffic_share">{{ 'RebelABTesting_FormTrafficShare'|translate }}</label>
            <input type="number" name="traffic_share" id="traffic_share" value="{{ experiment.traffic_share }}" min="1" max="100" required>
            <span class="form-hint">{{ 'RebelABTesting_FormTrafficShareHint'|translate }}</span>
        </div>
    </section>

    <section class="rebelABTestingPanel" data-panel="measures" data-kind="ab">
        <h3 class="form-section-title">{{ 'RebelABTesting_FormMeasures'|translate }}</h3>
        {{ _self.measure('primary_measure', 'RebelABTesting_FormPrimaryMeasure'|translate, 'RebelABTesting_FormPrimaryMeasureHint'|translate, experiment.primary_measure, measures) }}
        <details class="rebelABTestingMore"{% if experiment.guardrails is not empty %} open{% endif %}>
            <summary>{{ 'RebelABTesting_FormGuardrails'|translate }}</summary>
            <p class="form-hint">{{ 'RebelABTesting_FormGuardrailHint'|translate }}</p>
            {% for slot in guardrailSlots %}
            {{ _self.measure('guardrail_' ~ slot, 'RebelABTesting_FormGuardrail'|translate(slot + 1), '', experiment.guardrails[slot] ?? null, measures) }}
            {% endfor %}
        </details>
    </section>

    <section class="rebelABTestingPanel" data-panel="schedule">
        <h3 class="form-section-title">{{ 'RebelABTesting_FormSchedule'|translate }}</h3>
        <div class="rebelABTestingColumns">
            <div class="rebelABTestingField">
                <label for="from_date">{{ 'RebelABTesting_FormFromDate'|translate }}</label>
                <input type="date" name="from_date" id="from_date" value="{{ experiment.from_date }}" required>
                <span class="form-hint">{{ 'RebelABTesting_FormFromDateHint'|translate }}</span>
            </div>
            <div class="rebelABTestingField">
                <label for="to_date">{{ 'RebelABTesting_FormToDate'|translate }}</label>
                <input type="date" name="to_date" id="to_date" value="{{ experiment.to_date }}" required>
                <span class="form-hint">{{ 'RebelABTesting_FormToDateHint'|translate }}</span>
            </div>
        </div>

        <details class="rebelABTestingMore rebelABTestingPlanner" data-kind="ab" data-result="{{ 'RebelABTesting_PlannerResult'|translate('{days}', '{visits}', '{groups}') }}" data-unknown="{{ 'RebelABTesting_PlannerUnknown'|translate }}">
            <summary>{{ 'RebelABTesting_PlannerTitle'|translate }}</summary>
            <p class="form-hint">{{ 'RebelABTesting_PlannerHelp'|translate }}</p>
            <div class="rebelABTestingColumns rebelABTestingColumns-3">
                <div class="rebelABTestingField">
                    <label for="planner_visits">{{ 'RebelABTesting_PlannerVisits'|translate }}</label>
                    <input type="number" id="planner_visits" class="rebelABTestingPlannerVisits" min="1">
                </div>
                <div class="rebelABTestingField">
                    <label for="planner_rate">{{ 'RebelABTesting_PlannerRate'|translate }}</label>
                    <input type="number" id="planner_rate" class="rebelABTestingPlannerRate" min="0.01" max="99" step="0.01">
                </div>
                <div class="rebelABTestingField">
                    <label for="planner_effect">{{ 'RebelABTesting_PlannerEffect'|translate }}</label>
                    <input type="number" id="planner_effect" class="rebelABTestingPlannerEffect" min="1" value="10">
                    <span class="form-hint">{{ 'RebelABTesting_PlannerEffectHint'|translate }}</span>
                </div>
            </div>
            <p class="rebelABTestingPlannerResult" role="status"></p>
        </details>
    </section>

    <div class="rebelABTestingFooter">
        <button type="button" class="rebelABTestingSecondary rebelABTestingPrevious">{{ 'RebelABTesting_StepPrevious'|translate }}</button>
        <button type="button" class="rebelABTestingSecondary rebelABTestingNext">{{ 'RebelABTesting_StepNext'|translate }}</button>
        <span class="rebelABTestingFooterSpace"></span>
        {% if backUrl is defined %}<a href="{{ backUrl }}" class="rebelABTestingLink rebelABTestingBack">{{ 'General_Cancel'|translate }}</a>{% endif %}
        <input type="submit" value="{{ submitLabel }}" class="btn">
    </div>
</form>
