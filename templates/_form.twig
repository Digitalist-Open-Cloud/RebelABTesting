{% macro measure(field, label, hint, selected, measures) %}
    {% set choice = selected is null ? '' : (selected.type == 'goal' ? 'goal:' ~ selected.idgoal : selected.type) %}
    <div class="rebelExperimentsMeasure">
        <div class="rebelExperimentsField">
            <label for="{{ field }}">{{ label }}</label>
            <select name="{{ field }}" id="{{ field }}" class="browser-default">
                {% for value, name in measures %}
                <option value="{{ value }}"{% if (value ~ '') == choice %} selected{% endif %}>{{ name }}</option>
                {% endfor %}
            </select>
            {% if hint %}<span class="form-hint">{{ hint }}</span>{% endif %}
        </div>
        <div class="rebelExperimentsColumns rebelExperimentsMeasureEvent">
            <div class="rebelExperimentsField">
                <label for="{{ field }}_category">{{ 'RebelExperiments_FormEventCategory'|translate }}</label>
                <input type="text" name="{{ field }}_category" id="{{ field }}_category" value="{{ selected.category ?? '' }}" maxlength="200">
            </div>
            <div class="rebelExperimentsField">
                <label for="{{ field }}_action">{{ 'RebelExperiments_FormEventAction'|translate }}</label>
                <input type="text" name="{{ field }}_action" id="{{ field }}_action" value="{{ selected.action ?? '' }}" maxlength="200">
            </div>
        </div>
    </div>
{% endmacro %}

<form method="post" action="{{ actionUrl }}" class="rebelExperimentsForm">
    <input type="hidden" name="nonce" value="{{ nonce }}">
    {% if experiment.id is defined %}<input type="hidden" name="id" value="{{ experiment.id }}">{% endif %}

    <nav class="rebelExperimentsSteps" aria-label="{{ 'RebelExperiments_StepsLabel'|translate }}">
        <button type="button" class="rebelExperimentsStep" data-panel="basics"><span class="rebelExperimentsStepNumber"></span>{{ 'RebelExperiments_StepBasics'|translate }}</button>
        <button type="button" class="rebelExperimentsStep" data-panel="changes"><span class="rebelExperimentsStepNumber"></span><span data-kind="ab">{{ 'RebelExperiments_StepChanges'|translate }}</span><span data-kind="rollout">{{ 'RebelExperiments_StepChange'|translate }}</span><span data-kind="fake_door">{{ 'RebelExperiments_Kind_fake_door'|translate }}</span><span data-kind="watch">{{ 'RebelExperiments_StepWatch'|translate }}</span></button>
        <button type="button" class="rebelExperimentsStep" data-panel="audience"><span class="rebelExperimentsStepNumber"></span>{{ 'RebelExperiments_StepAudience'|translate }}</button>
        <button type="button" class="rebelExperimentsStep" data-panel="measures" data-kind="ab rollout"><span class="rebelExperimentsStepNumber"></span>{{ 'RebelExperiments_StepMeasures'|translate }}</button>
        <button type="button" class="rebelExperimentsStep" data-panel="schedule"><span class="rebelExperimentsStepNumber"></span>{{ 'RebelExperiments_StepSchedule'|translate }}</button>
    </nav>

    <section class="rebelExperimentsPanel" data-panel="basics">
        <h3 class="form-section-title">{{ 'RebelExperiments_FormKind'|translate }}</h3>
        <div class="rebelExperimentsKinds">
            {% for kind in kinds %}
            <label class="rebelExperimentsKindChoice">
                <input type="radio" name="kind" value="{{ kind }}" class="rebelExperimentsKind"{% if kind == experiment.kind %} checked{% endif %}>
                <span class="rebelExperimentsKindName">{{ ('RebelExperiments_Kind_' ~ kind)|translate }}</span>
                <span class="rebelExperimentsKindHelp">{{ ('RebelExperiments_KindHelp_' ~ kind)|translate }}</span>
            </label>
            {% endfor %}
        </div>

        <h3 class="form-section-title">{{ 'RebelExperiments_FormBasicInfo'|translate }}</h3>
        <div class="rebelExperimentsField">
            <label for="name">{{ 'RebelExperiments_ExperimentName'|translate }}</label>
            <input type="text" name="name" id="name" value="{{ experiment.name }}" maxlength="255" required>
        </div>
        <div class="rebelExperimentsField">
            <label for="hypothesis">{{ 'RebelExperiments_FormHypothesis'|translate }} <span class="rebelExperimentsOptional">{{ 'RebelExperiments_FormOptional'|translate }}</span></label>
            <input type="text" name="hypothesis" id="hypothesis" value="{{ experiment.hypothesis }}">
            <span class="form-hint">{{ 'RebelExperiments_FormHypothesisHint'|translate }}</span>
        </div>
        <div class="rebelExperimentsField">
            <label for="description">{{ 'General_Description'|translate }} <span class="rebelExperimentsOptional">{{ 'RebelExperiments_FormOptional'|translate }}</span></label>
            <input type="text" name="description" id="description" value="{{ experiment.description }}">
        </div>
    </section>

    <section class="rebelExperimentsPanel" data-panel="changes">
        <div data-kind="fake_door">
            {% set door = experiment.kind == 'fake_door' ? experiment.door : {selector: '', position: 'after', element: 'button', label: '', css_class: '', message: ''} %}
            <h3 class="form-section-title">{{ 'RebelExperiments_DoorTitle'|translate }}</h3>
            <p class="section-help">{{ 'RebelExperiments_DoorHelp'|translate }}</p>
            <div class="rebelExperimentsColumns">
                <div class="rebelExperimentsField">
                    <label for="door_label">{{ 'RebelExperiments_DoorLabel'|translate }}</label>
                    <input type="text" name="door[label]" id="door_label" value="{{ door.label }}" maxlength="200">
                </div>
                <div class="rebelExperimentsField">
                    <label for="door_element">{{ 'RebelExperiments_DoorElement'|translate }}</label>
                    <select name="door[element]" id="door_element" class="browser-default">
                        {% for element in doorElements %}
                        <option value="{{ element }}"{% if element == door.element %} selected{% endif %}>{{ ('RebelExperiments_DoorElement_' ~ element)|translate }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="rebelExperimentsField">
                <label for="door_message">{{ 'RebelExperiments_DoorMessage'|translate }}</label>
                <input type="text" name="door[message]" id="door_message" value="{{ door.message }}" maxlength="500">
                <span class="form-hint">{{ 'RebelExperiments_DoorMessageHint'|translate }}</span>
            </div>
            <div class="rebelExperimentsColumns">
                <div class="rebelExperimentsField">
                    <label for="door_selector">{{ 'RebelExperiments_DoorSelector'|translate }}</label>
                    <input type="text" name="door[selector]" id="door_selector" value="{{ door.selector }}" maxlength="500" placeholder="#main-menu">
                    <span class="form-hint">{{ 'RebelExperiments_DoorSelectorHint'|translate }}</span>
                </div>
                <div class="rebelExperimentsField">
                    <label for="door_position">{{ 'RebelExperiments_DoorPosition'|translate }}</label>
                    <select name="door[position]" id="door_position" class="browser-default">
                        {% for position in doorPositions %}
                        <option value="{{ position }}"{% if position == door.position %} selected{% endif %}>{{ ('RebelExperiments_DoorPosition_' ~ position)|translate }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <details class="rebelExperimentsMore"{% if door.css_class %} open{% endif %}>
                <summary>{{ 'RebelExperiments_FormMore'|translate }}</summary>
                <div class="rebelExperimentsField">
                    <label for="door_css_class">{{ 'RebelExperiments_DoorCssClass'|translate }}</label>
                    <input type="text" name="door[css_class]" id="door_css_class" value="{{ door.css_class }}" maxlength="200">
                    <span class="form-hint">{{ 'RebelExperiments_DoorCssClassHint'|translate }}</span>
                </div>
            </details>
        </div>

        <div data-kind="watch">
            <h3 class="form-section-title">{{ 'RebelExperiments_WatchTitle'|translate }}</h3>
            <p class="section-help">{{ 'RebelExperiments_WatchHelp'|translate }}</p>
            <div class="rebelExperimentsField">
                <label for="watch_selector">{{ 'RebelExperiments_WatchSelector'|translate }}</label>
                <input type="text" name="watch[selector]" id="watch_selector" value="{{ experiment.kind == 'watch' ? experiment.door.selector : '' }}" maxlength="500" placeholder=".newsletter-signup">
                <span class="form-hint">{{ 'RebelExperiments_WatchSelectorHint'|translate }}</span>
            </div>
        </div>

        <div data-kind="ab rollout">
            <p class="section-help">{{ 'RebelExperiments_FormVariantsHelp'|translate }}</p>
            <div class="rebelExperimentsVariants" data-max="{{ maxVariants }}">
                {% for variant in experiment.variants %}
                <fieldset class="rebelExperimentsVariant">
                    <div class="rebelExperimentsVariantHead">
                        <span class="rebelExperimentsVariantTitle">{{ 'RebelExperiments_Variant'|translate }} <span class="rebelExperimentsVariantNumber">{{ loop.index }}</span></span>
                        <input type="text" name="variants[{{ loop.index0 }}][name]" value="{{ variant.name }}" maxlength="100" placeholder="{{ 'RebelExperiments_VariantNamePlaceholder'|translate }}" aria-label="{{ 'General_Name'|translate }}">
                        <button type="button" class="rebelExperimentsLink rebelExperimentsRemoveVariant">{{ 'RebelExperiments_FormRemoveVariant'|translate }}</button>
                    </div>

                    <div class="rebelExperimentsField rebelExperimentsTemplateField">
                        <label>{{ 'RebelExperiments_TemplateStart'|translate }}</label>
                        <select class="browser-default rebelExperimentsTemplate">
                            <option value="">{{ 'RebelExperiments_TemplateNone'|translate }}</option>
                            {% for key, template in templates %}
                            <option value="{{ key }}" data-changes="{{ template.changes|json_encode }}">{{ template.name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="rebelExperimentsChangeHead">
                        <span>{{ 'RebelExperiments_ChangeSelector'|translate }}</span>
                        <span>{{ 'RebelExperiments_ChangeAction'|translate }}</span>
                        <span>{{ 'RebelExperiments_ChangeValue'|translate }}</span>
                    </div>
                    <div class="rebelExperimentsChanges">
                        {% for change in (variant.changes is empty ? [{selector: '', action: 'text', value: ''}] : variant.changes) %}
                        <div class="rebelExperimentsChange">
                            <input type="text" name="variants[{{ loop.parent.loop.index0 }}][changes][{{ loop.index0 }}][selector]" value="{{ change.selector }}" maxlength="500" placeholder="h1" aria-label="{{ 'RebelExperiments_ChangeSelector'|translate }}">
                            <select name="variants[{{ loop.parent.loop.index0 }}][changes][{{ loop.index0 }}][action]" class="browser-default" aria-label="{{ 'RebelExperiments_ChangeAction'|translate }}">
                                {% for action in actions %}
                                <option value="{{ action }}" data-placeholder="{{ ('RebelExperiments_ActionValue_' ~ action)|translate }}"{% if action == change.action %} selected{% endif %}>{{ ('RebelExperiments_Action_' ~ action)|translate }}</option>
                                {% endfor %}
                            </select>
                            <input type="text" name="variants[{{ loop.parent.loop.index0 }}][changes][{{ loop.index0 }}][value]" value="{{ change.value }}" maxlength="2000" aria-label="{{ 'RebelExperiments_ChangeValue'|translate }}">
                            <button type="button" class="rebelExperimentsIconButton rebelExperimentsRemoveChange" title="{{ 'RebelExperiments_ChangeRemove'|translate }}" aria-label="{{ 'RebelExperiments_ChangeRemove'|translate }}">&times;</button>
                        </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="rebelExperimentsLink rebelExperimentsAddChange">+ {{ 'RebelExperiments_ChangeAdd'|translate }}</button>
                    <p class="form-hint">{{ 'RebelExperiments_ChangesHelp'|translate }}</p>

                    <details class="rebelExperimentsMore"{% if variant.redirect %} open{% endif %}>
                        <summary>{{ 'RebelExperiments_RedirectTitle'|translate }}</summary>
                        <div class="rebelExperimentsField">
                            <label>{{ 'RebelExperiments_RedirectAddress'|translate }}</label>
                            <input type="text" name="variants[{{ loop.index0 }}][redirect]" value="{{ variant.redirect }}" maxlength="2000" placeholder="/pricing-b">
                            <span class="form-hint">{{ 'RebelExperiments_RedirectHint'|translate }}</span>
                        </div>
                    </details>

                    {% if canUseCode %}
                    <details class="rebelExperimentsMore"{% if variant.css or variant.js %} open{% endif %}>
                        <summary>{{ 'RebelExperiments_CodeTitle'|translate }}</summary>
                        <div class="rebelExperimentsField">
                            <label>CSS</label>
                            <textarea name="variants[{{ loop.index0 }}][css]" class="code-textarea" placeholder=".btn { background-color: #ff5722; }">{{ variant.css }}</textarea>
                        </div>
                        <div class="rebelExperimentsField">
                            <label>JavaScript</label>
                            <textarea name="variants[{{ loop.index0 }}][js]" class="code-textarea" placeholder="document.querySelector('h1').textContent = 'New headline';">{{ variant.js }}</textarea>
                        </div>
                    </details>
                    {% endif %}
                </fieldset>
                {% endfor %}
            </div>
            <button type="button" class="rebelExperimentsLink rebelExperimentsAddVariant">+ {{ 'RebelExperiments_FormAddVariant'|translate }}</button>
        </div>
    </section>

    <section class="rebelExperimentsPanel" data-panel="audience">
        <h3 class="form-section-title">{{ 'RebelExperiments_FormPages'|translate }}</h3>
        <div class="rebelExperimentsColumns">
            <div class="rebelExperimentsField">
                <label for="target_match">{{ 'RebelExperiments_FormTargetMatch'|translate }}</label>
                <select name="target_match" id="target_match" class="browser-default">
                    {% for match in matches %}
                    <option value="{{ match }}"{% if match == experiment.target_match %} selected{% endif %}>{{ ('RebelExperiments_Match_' ~ match)|translate }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="rebelExperimentsField rebelExperimentsTargetValue">
                <label for="target_value">{{ 'RebelExperiments_FormTargetValue'|translate }}</label>
                <input type="text" name="target_value" id="target_value" value="{{ experiment.target_value }}" maxlength="1000" placeholder="/pricing">
                <span class="form-hint">{{ 'RebelExperiments_FormTargetValueHint'|translate }}</span>
            </div>
        </div>

        <details class="rebelExperimentsMore"{% if experiment.exclude_match != 'none' %} open{% endif %}>
            <summary>{{ 'RebelExperiments_FormExclude'|translate }}</summary>
            <div class="rebelExperimentsColumns">
                <div class="rebelExperimentsField">
                    <label for="exclude_match">{{ 'RebelExperiments_FormExcludeMatch'|translate }}</label>
                    <select name="exclude_match" id="exclude_match" class="browser-default">
                        {% for match in excludes %}
                        <option value="{{ match }}"{% if match == experiment.exclude_match %} selected{% endif %}>{{ (match == 'none' ? 'RebelExperiments_ExcludeNone' : 'RebelExperiments_Match_' ~ match)|translate }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="rebelExperimentsField rebelExperimentsExcludeValue">
                    <label for="exclude_value">{{ 'RebelExperiments_FormTargetValue'|translate }}</label>
                    <input type="text" name="exclude_value" id="exclude_value" value="{{ experiment.exclude_value }}" maxlength="1000" placeholder="/checkout">
                </div>
            </div>
        </details>

        <h3 class="form-section-title">{{ 'RebelExperiments_FormVisitors'|translate }}</h3>
        <div class="rebelExperimentsField rebelExperimentsNarrow">
            <label for="traffic_share"><span data-kind="ab fake_door watch">{{ 'RebelExperiments_FormTrafficShare'|translate }}</span><span data-kind="rollout">{{ 'RebelExperiments_RolloutShare'|translate }}</span></label>
            <input type="number" name="traffic_share" id="traffic_share" value="{{ experiment.traffic_share }}" min="1" max="100" required>
            <span class="form-hint" data-kind="ab fake_door watch">{{ 'RebelExperiments_FormTrafficShareHint'|translate }}</span>
            <span class="form-hint" data-kind="rollout">{{ 'RebelExperiments_RolloutShareHint'|translate }}</span>
        </div>

        <h3 class="form-section-title">{{ 'RebelExperiments_AudienceTitle'|translate }}</h3>
        <p class="section-help">{{ 'RebelExperiments_AudienceHelp'|translate }}</p>
        <div class="rebelExperimentsColumns">
            <div class="rebelExperimentsField">
                <label for="audience_visitor">{{ 'RebelExperiments_AudienceVisitor'|translate }}</label>
                <select name="audience[visitor]" id="audience_visitor" class="browser-default">
                    {% for visitor in audienceVisitors %}
                    <option value="{{ visitor }}"{% if visitor == experiment.audience.visitor %} selected{% endif %}>{{ (visitor == '' ? 'RebelExperiments_AudienceEveryone' : 'RebelExperiments_AudienceVisitor_' ~ visitor)|translate }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="rebelExperimentsField">
                <label>{{ 'RebelExperiments_AudienceDevices'|translate }}</label>
                <div class="rebelExperimentsChecks">
                    {% for device in audienceDevices %}
                    <label><input type="checkbox" name="audience[devices][]" value="{{ device }}"{% if device in experiment.audience.devices %} checked{% endif %}><span>{{ ('RebelExperiments_AudienceDevice_' ~ device)|translate }}</span></label>
                    {% endfor %}
                </div>
                <span class="form-hint">{{ 'RebelExperiments_AudienceDevicesHint'|translate }}</span>
            </div>
        </div>
        <details class="rebelExperimentsMore"{% if experiment.audience.campaign or experiment.audience.referrer or experiment.audience.languages %} open{% endif %}>
            <summary>{{ 'RebelExperiments_AudienceMore'|translate }}</summary>
            <div class="rebelExperimentsColumns">
                <div class="rebelExperimentsField">
                    <label for="audience_campaign">{{ 'RebelExperiments_AudienceCampaign'|translate }}</label>
                    <input type="text" name="audience[campaign]" id="audience_campaign" value="{{ experiment.audience.campaign }}" maxlength="200" placeholder="spring-sale">
                    <span class="form-hint">{{ 'RebelExperiments_AudienceCampaignHint'|translate }}</span>
                </div>
                <div class="rebelExperimentsField">
                    <label for="audience_referrer">{{ 'RebelExperiments_AudienceReferrer'|translate }}</label>
                    <input type="text" name="audience[referrer]" id="audience_referrer" value="{{ experiment.audience.referrer }}" maxlength="200" placeholder="google.">
                    <span class="form-hint">{{ 'RebelExperiments_AudienceReferrerHint'|translate }}</span>
                </div>
            </div>
            <div class="rebelExperimentsField rebelExperimentsNarrow">
                <label for="audience_languages">{{ 'RebelExperiments_AudienceLanguages'|translate }}</label>
                <input type="text" name="audience[languages]" id="audience_languages" value="{{ experiment.audience.languages|join(', ') }}" maxlength="200" placeholder="sv, en">
                <span class="form-hint">{{ 'RebelExperiments_AudienceLanguagesHint'|translate }}</span>
            </div>
        </details>
    </section>

    <section class="rebelExperimentsPanel" data-panel="measures" data-kind="ab rollout">
        <h3 class="form-section-title">{{ 'RebelExperiments_FormMeasures'|translate }}</h3>
        {{ _self.measure('primary_measure', 'RebelExperiments_FormPrimaryMeasure'|translate, 'RebelExperiments_FormPrimaryMeasureHint'|translate, experiment.primary_measure, measures) }}
        <div class="rebelExperimentsField rebelExperimentsNarrow">
            <label for="confidence">{{ 'RebelExperiments_FormConfidence'|translate }}</label>
            <select name="confidence" id="confidence" class="browser-default">
                {% for confidence in confidences %}
                <option value="{{ confidence }}"{% if confidence == experiment.confidence %} selected{% endif %}>{{ confidence }}%</option>
                {% endfor %}
            </select>
            <span class="form-hint">{{ 'RebelExperiments_FormConfidenceHint'|translate }}</span>
        </div>
        <div class="rebelExperimentsField">
            <label><input type="checkbox" name="notify" value="1"{% if experiment.notify %} checked{% endif %}><span>{{ 'RebelExperiments_FormNotify'|translate }}</span></label>
            <span class="form-hint">{{ 'RebelExperiments_FormNotifyHint'|translate }}</span>
        </div>
        <details class="rebelExperimentsMore"{% if experiment.guardrails is not empty %} open{% endif %}>
            <summary>{{ 'RebelExperiments_FormGuardrails'|translate }}</summary>
            <p class="form-hint">{{ 'RebelExperiments_FormGuardrailHint'|translate }}</p>
            {% for slot in guardrailSlots %}
            {{ _self.measure('guardrail_' ~ slot, 'RebelExperiments_FormGuardrail'|translate(slot + 1), '', experiment.guardrails[slot] ?? null, measures) }}
            {% endfor %}
        </details>
    </section>

    <section class="rebelExperimentsPanel" data-panel="schedule">
        <h3 class="form-section-title">{{ 'RebelExperiments_FormSchedule'|translate }}</h3>
        <div class="rebelExperimentsColumns">
            <div class="rebelExperimentsField">
                <label for="from_date">{{ 'RebelExperiments_FormFromDate'|translate }}</label>
                <input type="date" name="from_date" id="from_date" value="{{ experiment.from_date }}" required>
                <span class="form-hint">{{ 'RebelExperiments_FormFromDateHint'|translate }}</span>
            </div>
            <div class="rebelExperimentsField">
                <label for="to_date">{{ 'RebelExperiments_FormToDate'|translate }}</label>
                <input type="date" name="to_date" id="to_date" value="{{ experiment.to_date }}" required>
                <span class="form-hint">{{ 'RebelExperiments_FormToDateHint'|translate }}</span>
            </div>
        </div>

        <details class="rebelExperimentsMore rebelExperimentsPlanner" data-kind="ab" data-result="{{ 'RebelExperiments_PlannerResult'|translate('{days}', '{visits}', '{groups}') }}" data-unknown="{{ 'RebelExperiments_PlannerUnknown'|translate }}">
            <summary>{{ 'RebelExperiments_PlannerTitle'|translate }}</summary>
            <p class="form-hint">{{ 'RebelExperiments_PlannerHelp'|translate }}</p>
            <div class="rebelExperimentsColumns rebelExperimentsColumns-3">
                <div class="rebelExperimentsField">
                    <label for="planner_visits">{{ 'RebelExperiments_PlannerVisits'|translate }}</label>
                    <input type="number" id="planner_visits" class="rebelExperimentsPlannerVisits" min="1">
                </div>
                <div class="rebelExperimentsField">
                    <label for="planner_rate">{{ 'RebelExperiments_PlannerRate'|translate }}</label>
                    <input type="number" id="planner_rate" class="rebelExperimentsPlannerRate" min="0.01" max="99" step="0.01">
                </div>
                <div class="rebelExperimentsField">
                    <label for="planner_effect">{{ 'RebelExperiments_PlannerEffect'|translate }}</label>
                    <input type="number" id="planner_effect" class="rebelExperimentsPlannerEffect" min="1" value="10">
                    <span class="form-hint">{{ 'RebelExperiments_PlannerEffectHint'|translate }}</span>
                </div>
            </div>
            <p class="rebelExperimentsPlannerResult" role="status"></p>
        </details>
    </section>

    <div class="rebelExperimentsFooter">
        <button type="button" class="rebelExperimentsSecondary rebelExperimentsPrevious">{{ 'RebelExperiments_StepPrevious'|translate }}</button>
        <button type="button" class="rebelExperimentsSecondary rebelExperimentsNext">{{ 'RebelExperiments_StepNext'|translate }}</button>
        <span class="rebelExperimentsFooterSpace"></span>
        {% if backUrl is defined %}<a href="{{ backUrl }}" class="rebelExperimentsLink rebelExperimentsBack">{{ 'General_Cancel'|translate }}</a>{% endif %}
        <input type="submit" value="{{ submitLabel }}" class="btn">
    </div>
</form>
