<form method="post" action="{{ actionUrl }}" class="rebelABTestingForm">
    <input type="hidden" name="nonce" value="{{ nonce }}">
    {% if experiment.id is defined %}<input type="hidden" name="id" value="{{ experiment.id }}">{% endif %}

    <h3 class="form-section-title">{{ 'RebelABTesting_FormBasicInfo'|translate }}</h3>
    <div class="row">
        <div class="col s12 m6 form-field">
            <label for="kind">{{ 'RebelABTesting_FormKind'|translate }}</label>
            <select name="kind" id="kind" class="browser-default rebelABTestingKind">
                {% for kind in kinds %}
                <option value="{{ kind }}"{% if kind == experiment.kind %} selected{% endif %}>{{ ('RebelABTesting_Kind_' ~ kind)|translate }}</option>
                {% endfor %}
            </select>
            <span class="form-hint">{{ 'RebelABTesting_FormKindHint'|translate }}</span>
        </div>
    </div>
    <div class="row">
        <div class="col s12 m6 form-field">
            <label for="name">{{ 'RebelABTesting_ExperimentName'|translate }}</label>
            <input type="text" name="name" id="name" value="{{ experiment.name }}" maxlength="255" required>
        </div>
        <div class="col s12 m6 form-field">
            <label for="hypothesis">{{ 'RebelABTesting_FormHypothesis'|translate }}</label>
            <input type="text" name="hypothesis" id="hypothesis" value="{{ experiment.hypothesis }}">
            <span class="form-hint">{{ 'RebelABTesting_FormHypothesisHint'|translate }}</span>
        </div>
    </div>
    <div class="row">
        <div class="col s12 m6 form-field">
            <label for="description">{{ 'General_Description'|translate }}</label>
            <input type="text" name="description" id="description" value="{{ experiment.description }}">
        </div>
    </div>

    <h3 class="form-section-title">{{ 'RebelABTesting_FormSchedule'|translate }}</h3>
    <div class="row">
        <div class="col s12 m6 form-field">
            <label for="from_date">{{ 'RebelABTesting_FormFromDate'|translate }}</label>
            <input type="date" name="from_date" id="from_date" value="{{ experiment.from_date }}" required>
            <span class="form-hint">{{ 'RebelABTesting_FormFromDateHint'|translate }}</span>
        </div>
        <div class="col s12 m6 form-field">
            <label for="to_date">{{ 'RebelABTesting_FormToDate'|translate }}</label>
            <input type="date" name="to_date" id="to_date" value="{{ experiment.to_date }}" required>
            <span class="form-hint">{{ 'RebelABTesting_FormToDateHint'|translate }}</span>
        </div>
    </div>

    <div class="rebelABTestingPlanner" data-kind="ab" data-result="{{ 'RebelABTesting_PlannerResult'|translate('{days}', '{visits}', '{groups}') }}" data-unknown="{{ 'RebelABTesting_PlannerUnknown'|translate }}">
        <h3 class="form-section-title">{{ 'RebelABTesting_PlannerTitle'|translate }}</h3>
        <p class="section-help">{{ 'RebelABTesting_PlannerHelp'|translate }}</p>
        <div class="row">
            <div class="col s12 m4 form-field">
                <label for="planner_visits">{{ 'RebelABTesting_PlannerVisits'|translate }}</label>
                <input type="number" id="planner_visits" class="rebelABTestingPlannerVisits" min="1">
            </div>
            <div class="col s12 m4 form-field">
                <label for="planner_rate">{{ 'RebelABTesting_PlannerRate'|translate }}</label>
                <input type="number" id="planner_rate" class="rebelABTestingPlannerRate" min="0.01" max="99" step="0.01">
            </div>
            <div class="col s12 m4 form-field">
                <label for="planner_effect">{{ 'RebelABTesting_PlannerEffect'|translate }}</label>
                <input type="number" id="planner_effect" class="rebelABTestingPlannerEffect" min="1" value="10">
                <span class="form-hint">{{ 'RebelABTesting_PlannerEffectHint'|translate }}</span>
            </div>
        </div>
        <p class="rebelABTestingPlannerResult" role="status"></p>
    </div>

    <h3 class="form-section-title">{{ 'RebelABTesting_FormAudience'|translate }}</h3>
    <div class="row">
        <div class="col s12 m6 form-field">
            <label for="target_match">{{ 'RebelABTesting_FormTargetMatch'|translate }}</label>
            <select name="target_match" id="target_match" class="browser-default">
                {% for match in matches %}
                <option value="{{ match }}"{% if match == experiment.target_match %} selected{% endif %}>{{ ('RebelABTesting_Match_' ~ match)|translate }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col s12 m6 form-field">
            <label for="target_value">{{ 'RebelABTesting_FormTargetValue'|translate }}</label>
            <input type="text" name="target_value" id="target_value" value="{{ experiment.target_value }}" maxlength="1000">
            <span class="form-hint">{{ 'RebelABTesting_FormTargetValueHint'|translate }}</span>
        </div>
    </div>
    <div class="row">
        <div class="col s12 m6 form-field">
            <label for="traffic_share">{{ 'RebelABTesting_FormTrafficShare'|translate }}</label>
            <input type="number" name="traffic_share" id="traffic_share" value="{{ experiment.traffic_share }}" min="1" max="100" required>
            <span class="form-hint">{{ 'RebelABTesting_FormTrafficShareHint'|translate }}</span>
        </div>
    </div>

    <div data-kind="fake_door">
        {% set door = experiment.door ?: {selector: '', position: 'after', element: 'button', label: '', css_class: '', message: ''} %}
        <h3 class="form-section-title">{{ 'RebelABTesting_DoorTitle'|translate }}</h3>
        <p class="section-help">{{ 'RebelABTesting_DoorHelp'|translate }}</p>
        <div class="row">
            <div class="col s12 m6 form-field">
                <label for="door_label">{{ 'RebelABTesting_DoorLabel'|translate }}</label>
                <input type="text" name="door[label]" id="door_label" value="{{ door.label }}" maxlength="200">
            </div>
            <div class="col s12 m6 form-field">
                <label for="door_message">{{ 'RebelABTesting_DoorMessage'|translate }}</label>
                <input type="text" name="door[message]" id="door_message" value="{{ door.message }}" maxlength="500">
                <span class="form-hint">{{ 'RebelABTesting_DoorMessageHint'|translate }}</span>
            </div>
        </div>
        <div class="row">
            <div class="col s12 m6 form-field">
                <label for="door_selector">{{ 'RebelABTesting_DoorSelector'|translate }}</label>
                <input type="text" name="door[selector]" id="door_selector" value="{{ door.selector }}" maxlength="500">
                <span class="form-hint">{{ 'RebelABTesting_DoorSelectorHint'|translate }}</span>
            </div>
            <div class="col s12 m6 form-field">
                <label for="door_position">{{ 'RebelABTesting_DoorPosition'|translate }}</label>
                <select name="door[position]" id="door_position" class="browser-default">
                    {% for position in doorPositions %}
                    <option value="{{ position }}"{% if position == door.position %} selected{% endif %}>{{ ('RebelABTesting_DoorPosition_' ~ position)|translate }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col s12 m6 form-field">
                <label for="door_element">{{ 'RebelABTesting_DoorElement'|translate }}</label>
                <select name="door[element]" id="door_element" class="browser-default">
                    {% for element in doorElements %}
                    <option value="{{ element }}"{% if element == door.element %} selected{% endif %}>{{ ('RebelABTesting_DoorElement_' ~ element)|translate }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col s12 m6 form-field">
                <label for="door_css_class">{{ 'RebelABTesting_DoorCssClass'|translate }}</label>
                <input type="text" name="door[css_class]" id="door_css_class" value="{{ door.css_class }}" maxlength="200">
                <span class="form-hint">{{ 'RebelABTesting_DoorCssClassHint'|translate }}</span>
            </div>
        </div>
    </div>

    <div data-kind="ab">
    <h3 class="form-section-title">{{ 'RebelABTesting_FormPrimaryGoal'|translate }}</h3>
    <div class="row">
        <div class="col s12 m6 form-field">
            {% set primaryGoal = experiment.primary_goal is null ? '' : (experiment.primary_goal == 0 ? 'ecommerceOrder' : experiment.primary_goal) %}
            <label for="primary_goal">{{ 'RebelABTesting_FormPrimaryGoal'|translate }}</label>
            <select name="primary_goal" id="primary_goal" class="browser-default">
                {% for value, label in goals %}
                <option value="{{ value }}"{% if (value ~ '') == (primaryGoal ~ '') %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <span class="form-hint">{{ 'RebelABTesting_FormPrimaryGoalHint'|translate }}</span>
        </div>
    </div>

    <h3 class="form-section-title">{{ 'RebelABTesting_FormVariants'|translate }}</h3>
    <p class="section-help">{{ 'RebelABTesting_FormVariantsHelp'|translate }}</p>
    <div class="rebelABTestingVariants" data-max="{{ maxVariants }}">
        {% for variant in experiment.variants %}
        <fieldset class="rebelABTestingVariant">
            <legend>{{ 'RebelABTesting_Variant'|translate }} <span class="rebelABTestingVariantNumber">{{ loop.index }}</span></legend>
            <div class="form-field">
                <label>{{ 'General_Name'|translate }}</label>
                <input type="text" name="variants[{{ loop.index0 }}][name]" value="{{ variant.name }}" maxlength="100">
            </div>
            <div class="code-field">
                <label>CSS</label>
                <textarea name="variants[{{ loop.index0 }}][css]" class="code-textarea">{{ variant.css }}</textarea>
                <span class="form-hint">{{ 'RebelABTesting_FormExample'|translate }} <code>.btn { background-color: #ff5722; }</code></span>
            </div>
            <div class="code-field">
                <label>JavaScript</label>
                <textarea name="variants[{{ loop.index0 }}][js]" class="code-textarea">{{ variant.js }}</textarea>
                <span class="form-hint">{{ 'RebelABTesting_FormExample'|translate }} <code>document.querySelector('h1').textContent = 'New headline';</code></span>
            </div>
            <button type="button" class="btn btn-flat rebelABTestingRemoveVariant">{{ 'RebelABTesting_FormRemoveVariant'|translate }}</button>
        </fieldset>
        {% endfor %}
    </div>
    <button type="button" class="btn btn-flat rebelABTestingAddVariant">{{ 'RebelABTesting_FormAddVariant'|translate }}</button>
    </div>

    <div class="form-actions">
        <input type="submit" value="{{ submitLabel }}" class="btn">
        {% if backUrl is defined %}<a href="{{ backUrl }}" class="btn btn-flat">{{ 'General_Cancel'|translate }}</a>{% endif %}
    </div>
</form>
